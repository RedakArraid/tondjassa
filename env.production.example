# =============================================================================
# MANDEMARKET - Variables d'environnement Production
# =============================================================================
# Copiez ce fichier vers .env.production et remplissez les valeurs
# cp env.production.example .env.production
# =============================================================================

# -----------------------------------------------------------------------------
# Base de données PostgreSQL
# -----------------------------------------------------------------------------
MANDEMARKET_DB_NAME=mandemarket
MANDEMARKET_DB_USER=postgres
MANDEMARKET_DB_PASSWORD=CHANGEZ_CE_MOT_DE_PASSE

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
MANDEMARKET_REDIS_PASSWORD=CHANGEZ_CE_MOT_DE_PASSE_REDIS

# -----------------------------------------------------------------------------
# JWT (Authentification)
# -----------------------------------------------------------------------------
# Générez un secret fort: openssl rand -base64 64
MANDEMARKET_JWT_SECRET=CHANGEZ_CE_SECRET_JWT
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
MANDEMARKET_CORS_ORIGIN=https://mandemarket.soubadigital.com,https://apimandemarket.soubadigital.com

# -----------------------------------------------------------------------------
# Cloudinary (Stockage d'images)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://apimandemarket.soubadigital.com
NEXT_PUBLIC_SITE_URL=https://mandemarket.soubadigital.com
NEXT_PUBLIC_APP_NAME=MandeMarket
NEXT_PUBLIC_APP_VERSION=2.1.0

# -----------------------------------------------------------------------------
# Paiements (obligatoire pour checkout en ligne)
# -----------------------------------------------------------------------------
# Afrique — Paystack (Mobile Money + cartes)
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...

# Afrique — CinetPay (fallback optionnel)
CINETPAY_SITE_ID=
CINETPAY_API_KEY=

# Europe — Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# -----------------------------------------------------------------------------
# Limites et configuration
# -----------------------------------------------------------------------------
MAX_FILE_SIZE=5242880
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100


# Production hardening: replace these before launch; no placeholders accepted for JWT.
TRUST_PROXY=172.20.0.2/32
CHECKOUT_COUNTRIES=CI,FR
BACKEND_URL=https://apimandemarket.soubadigital.com
NEXT_PUBLIC_SITE_URL=https://mandemarket.soubadigital.com
SMTP_PASS=
SEED_DATA=false
