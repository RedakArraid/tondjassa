{
  "name": "mandemarket-backend",
  "version": "2.0.0",
  "description": "Backend API pour MandeMarket - E-commerce complet",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "build": "node -e 'console.log(\"Backend build valid\")'",
    "type-check": "node -e 'console.log(\"Backend syntax valid\")'",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "reconciliation:check": "node scripts/verify-reconciliation.js",
    "seed:dev": "node scripts/seed.js",
    "reset:demo": "node scripts/demo-reset-seed.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "test": "jest",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.21.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "2.4.0",
    "nodemailer": "^7.0.0",
    "stripe": "^14.18.0",
    "zod": "^3.22.4",
    "prisma": "^6.19.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "@eslint/js": "^9.0.0",
    "globals": "^16.0.0"
  },
  "keywords": [
    "e-commerce",
    "api",
    "nodejs",
    "express",
    "prisma",
    "postgresql"
  ],
  "author": "MandeMarket Team",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  }
}
