// Schéma Prisma pour MandeMarket - Marketplace E-commerce Complète
// Convention monétaire : tous les montants sont stockés en CENTIMES (Int).
// Affichage FCFA = montant / 100.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== CATÉGORIES (avec sous-catégories) =====
model Category {
  id            String     @id @default(uuid())
  name          String
  slug          String     @unique
  description   String
  status        String     @default("active")
  parentId      String?
  parent        Category?  @relation("CategoryToSubcategory", fields: [parentId], references: [id])
  subcategories Category[] @relation("CategoryToSubcategory")
  displayOrder  Int        @default(0)
  products      Product[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([parentId])
  @@index([status])
}

// ===== VENDEURS (Marketplace) =====
model Seller {
  id                     String                        @id @default(uuid())
  userId                 String                        @unique
  user                   User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName              String
  slug                   String                        @unique
  description            String?
  logo                   String?
  status                 SellerStatus                  @default(pending)
  commissionRate         Float                         @default(10) // Pourcentage prélevé par la plateforme
  paymentInfo            Json? // { method, account, name, phone, iban, ... }
  totalSales             Int                           @default(0) // CA total (centimes)
  totalEarnings          Int                           @default(0) // Revenus nets après commission (centimes)
  rating                 Float                         @default(0) // Note moyenne (1-5)
  reviewCount            Int                           @default(0)
  products               Product[]
  orderItems             OrderItem[]
  payouts                SellerPayout[]
  ledgerEntries          SellerLedgerEntry[]
  promotions             Promotion[]
  members                SellerMember[]
  invitations            SellerInvitation[]
  notificationPreference SellerNotificationPreference?
  supportTickets         SupportTicket[]               @relation("SellerSupportTickets")
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt

  @@index([status])
  @@index([slug])
}

// ===== PRODUITS =====
model Product {
  id          Int           @id @default(autoincrement())
  name        String
  price       Int // centimes
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  sellerId    String? // null = produit plateforme (admin), sinon = vendeur
  seller      Seller?       @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  image       String?
  images      String[] // Galerie d'images
  description String
  stock       Int           @default(0) // Projection maintenue; source de vérité = Inventory
  status      ProductStatus @default(active)
  sku         String?
  brand       String?
  condition   String?       @default("new")
  material    String?
  lining      String?
  coating     String?
  dimensions  String?
  weight      Float?
  shape       String?
  styles      String[]
  pattern     String?
  decoration  String?
  closure     String?
  handles     String?
  season      String?
  occasion    String?
  features    String[]
  colors      String[]
  gender      String?
  ageGroup    String?
  orderItems  OrderItem[]
  inventory   Inventory?
  reviews     Review[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([sellerId, sku])
  @@index([categoryId])
  @@index([sellerId])
  @@index([status])
  @@index([sku])
}

// ===== UTILISATEURS =====
model User {
  id                        String                   @id @default(uuid())
  email                     String                   @unique
  password                  String
  emailVerifiedAt           DateTime?
  emailVerificationTokens   EmailVerificationToken[]
  name                      String?
  role                      UserRole                 @default(user)
  seller                    Seller?
  customer                  Customer?
  orders                    Order[]
  notifications             Notification[]
  sessions                  Session[]
  passwordResetTokens       PasswordResetToken[]
  auditLogs                 AuditLog[]
  sellerMemberships         SellerMember[]
  sellerInvitationsSent     SellerInvitation[]       @relation("SellerInvitationInviter")
  sellerInvitationsAccepted SellerInvitation[]       @relation("SellerInvitationAcceptedBy")
  supportTicketsCreated     SupportTicket[]          @relation("SupportTicketRequester")
  supportTicketsAssigned    SupportTicket[]          @relation("SupportTicketAssignee")
  supportMessages           SupportMessage[]
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  @@index([role])
}

// ===== CLIENTS =====
model Customer {
  id                   String                @id @default(uuid())
  userId               String?               @unique
  user                 User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  email                String                @unique
  firstName            String
  lastName             String
  phone                String?
  address              Address?
  orders               Order[]
  returnRequests       ReturnRequest[]
  promotionRedemptions PromotionRedemption[]
  reviews              Review[]
  totalSpent           Int                   @default(0) // centimes
  loyaltyPoints        Int                   @default(0)
  status               String                @default("active")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([email])
}

// ===== ADRESSES =====
model Address {
  id         String   @id @default(uuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  street     String
  city       String
  postalCode String
  country    String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ===== SESSIONS SÉCURISÉES (MM-BE-021) =====
model Session {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

// ===== TOKENS DE RÉINITIALISATION MOT DE PASSE =====
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

// ===== COMMANDES =====
model Order {
  id                   String                @id @default(uuid())
  orderNumber          String?               @unique
  customerId           String
  customer             Customer              @relation(fields: [customerId], references: [id])
  userId               String?
  user                 User?                 @relation(fields: [userId], references: [id])
  status               OrderStatus           @default(PENDING)
  currency             String                @default("XOF")
  exchangeRate         Float                 @default(1.0)
  subtotalAmount       Int                   @default(0) // centimes
  shippingCost         Int                   @default(0) // centimes
  taxAmount            Int                   @default(0) // centimes
  discountAmount       Int                   @default(0) // centimes
  totalAmount          Int // centimes
  promotionCode        String?
  customerSnapshot     Json?
  billingAddress       Json?
  shippingAddress      Json?
  checkoutSecretHash   String?
  refund               Refund?
  idempotencyKey       String?               @unique
  items                OrderItem[]
  payment              Payment?
  shipping             Shipping?
  returnRequests       ReturnRequest[]
  ledgerEntries        SellerLedgerEntry[]
  paymentEvents        PaymentEvent[]
  promotionRedemptions PromotionRedemption[]
  notes                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([customerId])
  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
}

// ===== ÉLÉMENTS DE COMMANDE =====
model OrderItem {
  fulfillmentStatus OrderStatus @default(PENDING)
  stockCommittedAt  DateTime?
  stockRestoredAt   DateTime?
  carrier           String?
  trackingCode      String?
  id                String      @id @default(uuid())
  orderId           String
  order             Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         Int
  product           Product     @relation(fields: [productId], references: [id])
  sellerId          String? // Pour commission et dashboard vendeur
  seller            Seller?     @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  productSnapshot   Json?
  selectedVariant   Json?
  sku               String?
  quantity          Int
  unitPrice         Int // centimes
  totalPrice        Int // centimes
  commissionRate    Float       @default(10)
  commissionAmount  Int         @default(0) // Commission plateforme (centimes)
  sellerEarnings    Int         @default(0) // Revenus vendeur après commission (centimes)
  createdAt         DateTime    @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([sellerId])
}

// ===== PAIEMENTS =====
model Payment {
  id                   String        @id @default(uuid())
  orderId              String        @unique
  order                Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount               Int // centimes
  method               PaymentMethod
  status               PaymentStatus @default(PENDING)
  transactionId        String?
  gateway              String?
  metadata             Json?
  processingExpiresAt  DateTime?
  verificationAttempts Int           @default(0)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([status])
  @@index([transactionId])
  @@index([status, processingExpiresAt])
}

// ===== EQUIPE BOUTIQUE =====
model SellerMember {
  id          String             @id @default(uuid())
  sellerId    String
  seller      Seller             @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        SellerTeamRole
  permissions String[]
  status      SellerMemberStatus @default(active)
  joinedAt    DateTime           @default(now())
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([sellerId, userId])
  @@index([userId, status])
}

model SellerInvitation {
  id           String                 @id @default(uuid())
  sellerId     String
  seller       Seller                 @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  email        String
  role         SellerTeamRole
  permissions  String[]
  tokenHash    String                 @unique
  status       SellerInvitationStatus @default(pending)
  invitedById  String
  invitedBy    User                   @relation("SellerInvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedById String?
  acceptedBy   User?                  @relation("SellerInvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([sellerId, email, status])
  @@index([expiresAt, status])
}

model SellerNotificationPreference {
  id               String   @id @default(uuid())
  sellerId         String   @unique
  seller           Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  newOrder         Boolean  @default(true)
  newMessage       Boolean  @default(true)
  newReview        Boolean  @default(true)
  newFollower      Boolean  @default(true)
  lowStock         Boolean  @default(true)
  payments         Boolean  @default(true)
  marketing        Boolean  @default(false)
  platformMessages Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Transactional email queue. An API success means "persisted", never "delivered".
model EmailOutbox {
  id          String            @id @default(uuid())
  dedupeKey   String?           @unique
  recipient   String
  template    String
  payload     Json
  status      EmailOutboxStatus @default(PENDING)
  attempts    Int               @default(0)
  maxAttempts Int               @default(5)
  availableAt DateTime          @default(now())
  lockedAt    DateTime?
  sentAt      DateTime?
  messageId   String?
  lastError   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status, availableAt])
}

// ===== ÉVÉNEMENTS & WEBHOOKS DE PAIEMENT (MM-BE-040) =====
model PaymentEvent {
  id             String   @id @default(uuid())
  orderId        String?
  order          Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  paymentId      String?
  gateway        String
  eventType      String
  idempotencyKey String   @unique
  payload        Json
  status         String   @default("PROCESSED") // PROCESSED, FAILED, IGNORED
  errorMessage   String?
  createdAt      DateTime @default(now())

  @@index([gateway, eventType])
  @@index([orderId])
  @@index([idempotencyKey])
}

// ===== LIVRAISONS =====
model Shipping {
  id                String         @id @default(uuid())
  orderId           String         @unique
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method            ShippingMethod
  status            ShippingStatus @default(PENDING)
  trackingCode      String?
  carrier           String?
  estimatedDelivery DateTime?
  actualDelivery    DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status])
  @@index([trackingCode])
}

// ===== PROMOTIONS =====
model Promotion {
  id          String                @id @default(uuid())
  sellerId    String?
  seller      Seller?               @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  code        String                @unique
  name        String
  description String
  type        PromotionType
  value       Int // % ou montant fixe en centimes selon type
  minAmount   Int? // seuil min en centimes
  maxUses     Int?
  usedCount   Int                   @default(0)
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean               @default(true)
  redemptions PromotionRedemption[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([code])
  @@index([isActive])
  @@index([sellerId, isActive])
}

// ===== UTILISATIONS DE PROMOTION (MM-BE-032) =====
model PromotionRedemption {
  id              String    @id @default(uuid())
  promotionId     String
  promotion       Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  discountApplied Int       @default(0) // centimes
  createdAt       DateTime  @default(now())

  @@unique([promotionId, orderId])
  @@index([customerId])
  @@index([promotionId])
}

// ===== STOCK ET INVENTAIRE (MM-BE-012) =====
model Inventory {
  id                String   @id @default(uuid())
  productId         Int      @unique
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity          Int // Stock physique réel
  reserved          Int      @default(0) // Stock réservé en cours de commande
  available         Int      @default(0) // Stock disponible (quantity - reserved)
  lowStockThreshold Int      @default(10)
  lastUpdated       DateTime @default(now())

  @@index([productId])
}

// ===== REGISTRE COMPTABLE VENDEUR (MM-BE-050) =====
model SellerLedgerEntry {
  id           String             @id @default(uuid())
  sellerId     String
  seller       Seller             @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  orderId      String?
  order        Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  payoutId     String?
  payout       SellerPayout?      @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  type         SellerLedgerType
  amount       Int // Montant en centimes (+ ou -)
  feeAmount    Int                @default(0) // Commission plateforme (centimes)
  netAmount    Int // Net crédité/débité au vendeur (centimes)
  status       SellerLedgerStatus @default(PENDING)
  description  String?
  balanceAfter Int? // Projection du solde après opération
  availableAt  DateTime?
  createdAt    DateTime           @default(now())

  @@index([sellerId, type])
  @@index([sellerId, status])
  @@index([orderId])
  @@index([createdAt])
}

// ===== VERSEMENTS VENDEURS (MM-BE-051) =====
model SellerPayout {
  id            String              @id @default(uuid())
  sellerId      String
  seller        Seller              @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  amount        Int // Montant versé (centimes)
  status        PayoutStatus        @default(pending)
  method        String? // bank_transfer, mobile_money, wave, orange_money, mtn
  reference     String?
  metadata      Json?
  paidAt        DateTime?
  ledgerEntries SellerLedgerEntry[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([sellerId])
  @@index([status])
}

// ===== DEMANDES DE RETOUR =====
model ReturnRequest {
  id          String       @id @default(uuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reason      String
  description String?
  status      ReturnStatus @default(pending)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([orderId])
  @@index([customerId])
  @@index([status])
}

// ===== AVIS CLIENTS =====
model Review {
  id            String       @id @default(uuid())
  productId     Int
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String
  customerEmail String?
  rating        Int // 1-5 étoiles
  title         String?
  comment       String
  sellerReply   String?
  sellerReplyAt DateTime?
  isVerified    Boolean      @default(false)
  helpful       Int          @default(0)
  status        ReviewStatus @default(approved)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([customerId, productId])
  @@index([productId])
  @@index([status])
  @@index([customerId])
}

// ===== NOTIFICATIONS =====
model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

// ===== SUPPORT CLIENT / VENDEUR =====
// Les tickets sont des données métier persistantes. AuditLog ne sert qu'à tracer
// les changements et ne remplace jamais l'historique de conversation.
model SupportTicket {
  id             String                @id @default(uuid())
  reference      String                @unique
  source         SupportTicketSource
  category       String                @default("Autre")
  subject        String
  status         SupportTicketStatus   @default(OPEN)
  priority       SupportTicketPriority @default(NORMAL)
  requesterName  String
  requesterEmail String
  requesterPhone String?
  sellerId       String?
  seller         Seller?               @relation("SellerSupportTickets", fields: [sellerId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?                 @relation("SupportTicketRequester", fields: [createdById], references: [id], onDelete: SetNull)
  assignedToId   String?
  assignedTo     User?                 @relation("SupportTicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages       SupportMessage[]
  lastMessageAt  DateTime              @default(now())
  resolvedAt     DateTime?
  closedAt       DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([status, priority])
  @@index([sellerId, createdAt])
  @@index([assignedToId, status])
  @@index([requesterEmail])
  @@index([lastMessageAt])
}

model SupportMessage {
  id         String               @id @default(uuid())
  ticketId   String
  ticket     SupportTicket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?                @relation(fields: [authorId], references: [id], onDelete: SetNull)
  sender     SupportMessageSender
  authorName String?
  message    String
  internal   Boolean              @default(false)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([ticketId, createdAt])
  @@index([authorId])
}

// ===== JOURNAL D'AUDIT (MM-BE-022 / MM-INF-091) =====
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ===== ABONNÉS NEWSLETTER =====
model NewsletterSubscriber {
  id             String    @id @default(uuid())
  email          String    @unique
  status         String    @default("active")
  source         String    @default("website")
  consentedAt    DateTime  @default(now())
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
}

// ===== ENUMS =====
enum UserRole {
  user
  customer
  seller
  manager
  support
  admin
}

enum SupportTicketSource {
  SELLER
  CONTACT
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportMessageSender {
  REQUESTER
  STAFF
  SYSTEM
}

enum SellerStatus {
  pending
  approved
  suspended
}

enum SellerTeamRole {
  manager
  catalog
  orders
  finance
}

enum SellerMemberStatus {
  active
  revoked
}

enum SellerInvitationStatus {
  pending
  accepted
  revoked
  expired
}

enum EmailOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum ProductStatus {
  draft
  active
  archived
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CARD
  PAYPAL
  BANK_TRANSFER
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum ShippingMethod {
  STANDARD
  EXPRESS
  PICKUP
}

enum ShippingStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  RETURNED
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum NotificationType {
  ORDER_STATUS
  STOCK_ALERT
  PAYMENT
  SHIPPING
  SYSTEM
}

enum PayoutStatus {
  pending
  processing
  completed
  failed
  cancelled
}

enum ReturnStatus {
  pending
  approved
  rejected
  completed
}

enum ReviewStatus {
  pending
  approved
  rejected
}

enum SellerLedgerType {
  SALE_PENDING
  SALE_AVAILABLE
  COMMISSION
  REFUND
  PAYOUT_RESERVED
  PAYOUT_COMPLETED
  PAYOUT_RELEASED
  ADJUSTMENT
}

enum SellerLedgerStatus {
  PENDING
  AVAILABLE
  LOCKED
  CLEARED
  CANCELLED
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Full-order refunds only. A request is not a completed provider refund.
model Refund {
  id                String    @id @default(uuid())
  orderId           String    @unique
  order             Order     @relation(fields: [orderId], references: [id])
  gateway           String
  transactionId     String?
  amount            Int
  currency          String
  status            String    @default("REQUESTED")
  restockRequested  Boolean   @default(false)
  providerReference String?
  reason            String?
  error             String?
  submittedAt       DateTime?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
}
