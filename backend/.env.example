# Variables d'environnement pour le backend MandeMarket
# Copier ce fichier en .env pour l'utiliser

# Base de données PostgreSQL
# Avec docker compose du repo : Postgres est exposé sur le port hôte 5433
DATABASE_URL="postgresql://postgres:mandemarket123@localhost:5433/mandemarket"

# Configuration JWT
JWT_SECRET="mandemarket-super-secret-jwt-key-change-in-production-2024"

# Environnement
NODE_ENV=development

# Port du serveur
PORT=4002

# CORS - Origines autorisées
CORS_ORIGIN=http://localhost:3000

# Configuration Redis (pour le cache, sessions)
# Redis docker compose : port hôte 6380, mot de passe redis123
REDIS_URL="redis://:redis123@localhost:6380"
REDIS_PASSWORD="redis123"

# Configuration email (quand implémenté)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Configuration de stockage des fichiers
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Stripe / Paystack — voir backend/.env.docker.example pour la liste complète
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PAYSTACK_SECRET_KEY=sk_test_...
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Configuration de logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Configuration de sécurité
BCRYPT_ROUNDS=12
SESSION_SECRET="mandemarket-session-secret-change-in-production"

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Les requêtes réussies de navigation ne consomment pas le quota global.
# Les erreurs, l'authentification et les paiements restent limités séparément.
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=true
